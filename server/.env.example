# Server Port & CORS
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (MySQL / TiDB Serverless)
# Local MySQL example: mysql://root:password@localhost:3306/artify
# TiDB example: mysql://<user>:<password>@<host>:4000/artify?sslaccept=strict
DATABASE_URL=mysql://root:root@localhost:3306/artify

# Authentication
JWT_SECRET=super_secret_jwt_key_artify_hackathon_2026

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_IMAGE_MODEL=gemini-1.5-flash

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin (either file path e.g. ./firebase-service-account.json or raw JSON string)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Abuse prevention / quotas
DAILY_LISTING_CAP=20
